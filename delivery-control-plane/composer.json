{
    "name": "delivery/control-plane",
    "description": "Сервис control-plane для регистрации парка, лицензирования и релизов",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "delivery/contracts": "^1.0",
        "lcobucci/jwt": "^5.6",
        "doctrine/orm": "^3.6",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-foundation": "8.1.*",
        "symfony/routing": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "symfony/browser-kit": "8.1.*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../delivery-contracts"
        }
    ],
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
