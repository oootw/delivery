{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delivery/contracts/license.v1.json",
  "title": "LicenseResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tarif",
    "features",
    "status",
    "valid_until"
  ],
  "properties": {
    "tarif": {
      "type": "string",
      "enum": [
        "basic",
        "pro",
        "enterprise"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "past_due",
        "suspended",
        "expired"
      ]
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
