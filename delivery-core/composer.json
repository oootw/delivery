{
    "name": "delivery/core",
    "description": "Data-plane ядро сервиса владельца",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "delivery/contracts": "^1.0",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/http-foundation": "8.1.*",
        "symfony/routing": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/cache": "8.1.*",
        "symfony/yaml": "8.1.*",
        "lcobucci/jwt": "^5.6",
        "composer/semver": "^3.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../delivery-contracts"
        }
    ],
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
